# Paste into Dokploy > (compose project) > Environment, then fill in real values.
# Dokploy writes these to a .env next to docker-compose.yml; never commit real values.

# Database (the URL is built from these; use a URL-safe password: letters and digits).
POSTGRES_USER=fluxen
POSTGRES_PASSWORD=
POSTGRES_DB=fluxen_pos

# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Public URLs (no trailing slash).
APP_URL=https://pos.example.com
FRONTEND_URL=https://pos.example.com
# Optional: defaults to APP_URL.
# CORS_ORIGIN=https://pos.example.com,https://shop.example.com
# PUBLIC_ASSET_ORIGIN=https://pos.example.com

# Email (Resend).
RESEND_API_KEY=
EMAIL_FROM=Fluxen POS <no-reply@example.com>

# Paytm. The merchant key is exactly 16 characters. Use WEBSTAGING for the Paytm test site.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT

# Public "Try the demo" button on the login page (a shared, pre-filled demo shop).
# Off in production unless set to true. Reset its data with:
#   node dist/demo/run.js --reset   (run inside the fluxen-api container)
DEMO_ENABLED=true

# Platform operators (the admin center at /operator/login) are separate accounts, not shop
# users, so there is nothing to set here. Create one from inside the fluxen-api container:
#   node dist/billing/operator-admin.js create you@example.com "Your Name"
# It prints a one-time password. They sign in at /operator/login and set up an authenticator
# app on first sign-in. Operators also receive an email whenever a business sends a plan
# request. Other commands: reset-password, reset-2fa (lost phone), deactivate, activate, list.

# Dashboard build-time values (changing these needs a redeploy, which rebuilds).
NEXT_PUBLIC_API_DEFAULT_SHOP_CODE=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
