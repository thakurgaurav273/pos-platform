# Dependencies and build output are rebuilt inside the image.
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo
coverage
.pnpm-store

# Secrets and local data never go into an image.
**/.env
**/.env.*
*.sql
*.dump
apps/api/public/uploads

# Not needed to build or run.
.git
.idea
.vscode
.kiro
android-app
**/*.log
.DS_Store
